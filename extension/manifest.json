{
  "manifest_version": 3,
  "name": "AI Chat Bookmark",
  "version": "1.0",
  "description": "Bookmark specific AI chat responses (ChatGPT, Gemini, Claude, etc.) and jump to them later.",
  "icons": {
    "16": "icons/icon16.jpg",
    "48": "icons/icon48.jpg",
    "128": "icons/icon128.jpg"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.jpg"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["panel.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
